{
  "name": "graphite-earth",
  "version": "1.0.0",
  "description": "Graphite Earth — any city on Earth in 3D, drawn as a hand-made pencil, charcoal or blueprint sketch from OpenStreetMap data.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://pavanit1217.github.io/graphite-earth/",
  "repository": {
    "type": "git",
    "url": "https://github.com/PavanIT1217/graphite-earth.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "node scripts/screenshots.mjs",
    "icons": "node scripts/generate-icons.mjs && npx @capacitor/assets generate --iconBackgroundColor '#f3eee3' --iconBackgroundColorDark '#1b1d22' --splashBackgroundColor '#f3eee3' --splashBackgroundColorDark '#1b1d22'",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run cap:sync && cap open android",
    "ios": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/three": "^0.186.0",
    "fake-indexeddb": "^6.2.5",
    "playwright-core": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
